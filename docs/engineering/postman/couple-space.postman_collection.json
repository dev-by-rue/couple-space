    {
      "name": "3. Reveal flow (run in order)",
      "description": "Run Auth + Themes first. Each step asserts what A and B can see — partner text must stay null until THAT viewer reveals.",
      "item": [
        {
          "name": "01 Create session (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"sessionId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"promptId\": \"{{promptId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            }
          }
        },
        {
          "name": "02 View (A) — answering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "const me = pm.collectionVariables.get(\"userIdA\");",
                  "const own = d.responses.find(r => r.userId === me);",
                  "const partner = d.responses.find(r => r.userId !== me);",
                  "pm.test(\"phase is answering\", () => pm.expect(d.phase).to.eql(\"answering\"));",
                  "pm.test(\"own answer hidden\", () => pm.expect(own ? own.text : null).to.eql(null));",
                  "pm.test(\"partner answer hidden\", () => pm.expect(partner ? partner.text : null).to.eql(null));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}"
              ]
            }
          }
        },
