{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@couple-space/web",
    "watchPatterns": ["apps/web/**", "packages/domain/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @couple-space/web start",
    "restartPolicyType": "ON_FAILURE"
  }
}
