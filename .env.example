# Postgres
DATABASE_URL=

# API
API_PORT=8080
CORS_ORIGIN=http://localhost:3000

# Nest-owned auth (see docs/superpowers/specs/2026-08-30-nest-owned-auth-design.md)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=false
ENABLE_DEV_AUTH_ENDPOINTS=true

# Formation (later tasks)
INVITE_TTL_HOURS=72
INVITE_RATE_LIMIT_PER_HOUR=10

# Email verification — optional local SMTP from https://ethereal.email (create account, copy credentials)
WEB_ORIGIN=http://localhost:3000
EMAIL_VERIFY_TTL_HOURS=24
EMAIL_VERIFY_RESEND_PER_HOUR=5
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=<ethereal-user>
# SMTP_PASS=<ethereal-pass>
# SMTP_FROM=noreply@example.com

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080