# Postgres
DATABASE_URL=

# API
API_PORT=8080
CORS_ORIGIN=http://localhost:3000

# Nest-owned auth (see ADR-001 in docs/product/decisions.md)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=false
ENABLE_DEV_AUTH_ENDPOINTS=true

# Formation (later tasks)
INVITE_TTL_HOURS=72
INVITE_RATE_LIMIT_PER_HOUR=10

# Email verification — optional local SMTP from https://ethereal.email (create account, copy credentials)
WEB_ORIGIN=http://localhost:3000
EMAIL_VERIFY_TTL_HOURS=24
EMAIL_VERIFY_RESEND_PER_HOUR=5
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=<ethereal-user>
# SMTP_PASS=<ethereal-pass>
# SMTP_FROM=noreply@example.com
# Web push (P1-26). Generate with: pnpm --filter @couple-space/api exec web-push generate-vapid-keys
# Leave unset to turn sending off. Never rotate on a live environment.
# VAPID_PUBLIC_KEY=<public-key>
# VAPID_PRIVATE_KEY=<private-key>
# VAPID_SUBJECT=mailto:you@example.com

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
# Hosted only (see docs/deployment/railway.md): proxy /backend/* to the API so
# auth cookies stay first-party. Pair with NEXT_PUBLIC_API_URL=/backend.
# API_INTERNAL_URL=
# Temporary palette switcher (apps/web Theme Lab). Remove when exploration ends.
# NEXT_PUBLIC_THEME_LAB=1

# Relationship welcome quote (API Ninjas). Put these in apps/web/.env.local —
# Next only loads env from the web app directory, not the repo root.
# Prefer /v2/randomquotes (varies) or /v2/quoteoftheday (stable per day) over /v2/quotes.
# NEXT_QUOTE_API_URL=https://api.api-ninjas.com/v2/randomquotes
# NEXT_QUOTE_API_KEY=